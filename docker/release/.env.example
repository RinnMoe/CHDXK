CHDXK_VERSION=0.1.0
CHDXK_PUBLIC_URL=https://courses.example.com
CHDXK_BIND_ADDRESS=127.0.0.1
CHDXK_PORT=8088
COURSE_IMPORT_CONCURRENCY=64
SESSION_SECURE=true
# Use random alphanumeric values; do not use spaces in POSTGRES_PASSWORD.
POSTGRES_PASSWORD=replace_with_random_database_password
SESSION_SECRET=replace_with_at_least_32_random_characters
RESHUB_ISSUER=https://res.example.com
RESHUB_CLIENT_ID=chdxk
RESHUB_CLIENT_SECRET=replace_with_reshub_client_secret
